# --- Server ---
PORT=3000
# SQLite lives at $DATA_DIR/wa.db (Docker image sets DATA_DIR=/data)
DATA_DIR=./data

# --- Meta WhatsApp Cloud API (required) ---
# Permanent System User token (whatsapp_business_messaging + whatsapp_business_management)
WA_TOKEN=
# Phone Number ID from the Meta "API Setup" page (not the phone number itself)
WA_PHONE_NUMBER_ID=
# App Secret (App settings > Basic); used to verify X-Hub-Signature-256
WA_APP_SECRET=
# Any random string; enter the same value in the Meta webhook config
WA_VERIFY_TOKEN=

# --- Dashboard auth (required) ---
DASHBOARD_PASSWORD=
# Long random string (e.g. `openssl rand -hex 32`); signs login tokens
SESSION_SECRET=
# Allowed CORS origin(s), comma-separated, e.g. https://wa-dashboard.vercel.app,http://localhost:5173
DASHBOARD_ORIGIN=http://localhost:5173

# --- Catalog (optional; without WORKER_URL the bot runs with an empty catalog) ---
WORKER_URL=https://anyway-sync.mitang-sync-worker.workers.dev
BOT_SHARED_SECRET=
# Product links in auto-replies: $APP_BASE_URL/product/<id>
APP_BASE_URL=https://ais.mitangs.tech
