{
  "name": "wa-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "WhatsApp bot prototype server: Meta webhook, SQLite inbox, dashboard REST API, catalog auto-reply.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch --import tsx src/index.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env --max-old-space-size=96 dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"test/**/*.test.ts\""
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "hono": "^4.13.13"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
